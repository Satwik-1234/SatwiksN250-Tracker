# =================================================================
# N250 Tracker - Environment Configuration
# =================================================================

# 1. PostgreSQL Database Connection (CockroachDB 5GB, Neon, Xata, Supabase, or AWS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# 2. Owner Security PIN & Password (for instant unlock on web/mobile)
# These are REQUIRED server-side. If unset, owner mode is disabled entirely
# (the API fails closed) - there is deliberately no default credential.
OWNER_PIN="change-me-to-a-random-pin"
OWNER_PASSWORD="change-me-to-a-long-random-password"

# 3. Optional: secret used to sign the owner session cookie.
# If omitted, a key is derived from OWNER_PIN + OWNER_PASSWORD (server-only).
# Set it explicitly to rotate sessions independently of your PIN.
# SESSION_SECRET="a-long-random-string"

# 3. Optional Supabase Client Configuration (Backup & File Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
